QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_DOCUMENT_COLLECTION=document_chunks
QDRANT_SCORE_THRESHOLD=0.5
RRF_K=60
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_VARIANTS=3
RETRIEVAL_BACKEND=qdrant
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=multi_agent_rag
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_MULTIPLIER=3
DYNAMIC_TOP_K_ENABLED=true
DYNAMIC_TOP_K_MIN=3
DYNAMIC_TOP_K_MAX=8
DYNAMIC_TOP_K_GAP_HIGH=2.0
DYNAMIC_TOP_K_GAP_LOW=0.6
RAG_CONTEXT_BUDGET_TOKENS=1600
LLM_ANSWER_PROVIDER=
LLM_ANSWER_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=50
EMBEDDING_TIMEOUT_SECONDS=60
LLM_ANSWER_REQUIRED=false
LLM_ANSWER_TIMEOUT_SECONDS=60
LLM_ANSWER_MAX_TOKENS=220
DOCUMENT_TASK_BACKEND=local
DOCUMENT_TASK_FALLBACK_LOCAL=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUTH_REQUIRED=false
AUTH_ALLOW_REGISTRATION=true
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_ISSUER=multi-agent-rag
JWT_AUDIENCE=multi-agent-rag-api
HEALTH_REQUIRED_SERVICES=mongodb,qdrant,neo4j,ollama,task_queue
HEALTH_PROBE_TIMEOUT_SECONDS=2
